# ─────────────────────────────────────────────────────────────────────
# .dockerignore — Keep the build context lean and secure
# ─────────────────────────────────────────────────────────────────────
# This prevents secrets, dev files, and unnecessary bloat from
# entering the Docker build context, which both speeds up builds
# and reduces the attack surface of the final image.

# ── Version control ─────────────────────────────────────────────────
.git
.gitignore
.gitattributes
.gitmodules
.kilo

# ── Environment / Secrets ───────────────────────────────────────────
.env
.env.*
!.env.example
**/.env
**/secrets*
**/*.key
**/*.pem
**/*.cert

# ── Development tooling ─────────────────────────────────────────────
.vscode
.idea
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*.pyc
__pycache__/
*.pyo
*.pyd

# ── Notebooks / Docs ────────────────────────────────────────────────
notebooks/
*.ipynb
README.md
LICENSE
*.md
docs/

# ── Tests ───────────────────────────────────────────────────────────
tests/
*.test.py
*_test.py
conftest.py
test_*.py
coverage/
htmlcov/
.coverage
.coverage.*

# ── Build artifacts ─────────────────────────────────────────────────
dist/
build/
*.egg-info/
*.egg
.eggs/
*.whl
*.tar.gz

# ── Runtime data (must NOT be baked into the image) ──────────────────
# These directories hold the live database, backups, embeddings, uploads
# and logs. Excluding them keeps the image small and prevents production
# data (face_recognition.db, SQL dumps, FAISS index) from leaking into it.
data/
backups/
logs/
outputs/
unknown_faces/
uploads/
embeddings/
attendance/*.csv
*.db
*.sqlite
*.sqlite3

# ── Logs / Temp / Outputs (created at runtime) ──────────────────────
*.log
__pycache__/
*.py[cod]
*$py.class

# ── OS / System ─────────────────────────────────────────────────────
*.so
*.dylib
*.dll
*.exe
