# ─────────────────────────────────────────────────────────────────────
# Face Recognition AI — College Deployment Environment Variables
# ─────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in your values.
#   $ cp .env.example .env
#
# Then run:  docker compose up -d
# ─────────────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────────────
# In production, use PostgreSQL. In development, omitting these
# defaults to SQLite at ./data/face_recognition.db
DB_TYPE=postgres
DATABASE_URL=postgresql://faceai:changeme@db:5432/face_recognition
POSTGRES_USER=faceai
POSTGRES_PASSWORD=changeme
POSTGRES_DB=face_recognition

# Connection pool tuning (PostgreSQL only). pool_pre_ping transparently
# recycles stale connections after a DB restart.
DB_POOL_SIZE=5
DB_POOL_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true

# ── Redis ───────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Authentication & Security ───────────────────────────────────────
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-this-to-a-random-64-char-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── API Configuration ───────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:8501,http://dashboard:8501

# ── Rate Limiting ───────────────────────────────────────────────────
# Format: [count]/[window]
LOGIN_RATE_LIMIT=10/minute
API_RATE_LIMIT=100/minute
ENROLL_RATE_LIMIT=5/minute

# ── Camera Credentials (stored server-side, never sent to browser) ──
# Can reference a secrets manager URL or use inline credentials.
# Format: camera_id=rtsp://user:pass@host:port/stream
# CAMERA_CRED_001=rtsp://admin:password@192.168.1.50:554/stream1
# CAMERA_CRED_002=rtsp://admin:password@192.168.1.51:554/stream1

# ── File Uploads ────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=5
ALLOWED_UPLOAD_FORMATS=.jpg,.jpeg,.png

# ── AI / Recognition Settings ──────────────────────────────────────
# Override values in config/settings.yaml via environment. Precedence:
# environment variable > settings.yaml > built-in default. The env name is
# the uppercase config constant (see config/config.py).
YOLO_CONFIDENCE=0.5
RECOGNITION_THRESHOLD=1.0
FRAME_SKIP=2
COOLDOWN_SECONDS=60
IDENTITY_TTL=3.0

FACE_QUALITY_MIN_SCORE=0.35
LIVENESS_MIN_SCORE=0.30
LIVENESS_SPOOF_THRESHOLD=0.15
AMFR_HIGH_CONFIDENCE_THRESHOLD=0.70
AMFR_BORDERLINE_THRESHOLD=0.40
AMFR_WEIGHT_ARCFACE=0.45
AMFR_WEIGHT_LIVENESS=0.35
AMFR_WEIGHT_QUALITY=0.20

DEEP_LIVENESS_ENABLED=true
DEEP_LIVENESS_THRESHOLD=0.50
DEEP_LIVENESS_FALLBACK=true
DEEP_LIVENESS_AUTO_DOWNLOAD=true

FAISS_INDEX_TYPE=hnsw
FAISS_HNSW_M=64
FAISS_HNSW_EF_CONSTRUCTION=200
FAISS_HNSW_EF_SEARCH=128
FAISS_IVF_NLIST=200
FAISS_IVF_NPROBE=256

UNKNOWN_FACE_RETENTION_DAYS=30

# ── Logging ─────────────────────────────────────────────────────────
# LOG_LEVEL / LOG_FORMAT override config/settings.yaml → logging section.
# LOG_FORMAT=json emits one JSON object per line (SIEM / log shipper ready).
LOG_LEVEL=INFO
LOG_FORMAT=plain         # json | plain
LOG_MAX_SIZE_MB=10
LOG_BACKUP_COUNT=3

# ── Streamlit Dashboard ─────────────────────────────────────────────
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true

# ── Monitoring (optional) ───────────────────────────────────────────
# PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus
# ENABLE_METRICS=true

# ── External Services (optional) ────────────────────────────────────
# OIDC_ISSUER_URL=https://college-sso.example.com/auth/realms/college
# OIDC_CLIENT_ID=face-recognition-ai
# OIDC_CLIENT_SECRET=...
# SIEM_ENDPOINT=https://siem.example.com:443/events
